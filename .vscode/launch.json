{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (debug) on port 8010",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.server:app", "--port", "8010"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DB_PATH": "learning.db",
        "FIXED_DATE": "2026-10-02",
        "DEMO_DATA": "true",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: the file I have open",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-s", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Run the file I have open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}

# Copy to .env and fill in. Never commit .env.

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=

# Required. Signs login tokens. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional (defaults shown)
# DB_PATH=hr_chat.db
# TOKEN_TTL_MINUTES=60
# ANSWER_MODEL=claude-sonnet-5-5
# ROUTER_MODEL=claude-haiku-5-5     # Latest Haiku (retires no sooner than 2027-10-07).
#                                   # Also the model for the planning sub-agents, so they follow the switch.
# LOG_LEVEL=INFO

# Demo behavior. DEMO_DATA=true seeds a fictional company and shows demo accounts on the login page
# with a shared password. Set it to false for anything real.
# DEMO_DATA=true
# FIXED_DATE=2026-10-02   # pins "today" so the demo data (dated around 2 Oct 2026) behaves identically on any day
# REINDEX=false           # true re-indexes the policy files on start
